# Copy to .env (gitignored). Never commit real keys.
# Descriptions: docs/salvai-be-setup-and-env.md
# Cloud Run: copied on deploy via scripts/deploy-cloudrun.sh (.env.prod).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Production reminder cron (X-Api-Key on POST /api/v1/internal/notifications/dispatch)
INTERNAL_NOTIFICATIONS_KEY=

# Optional
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHOCO_DATA_API_KEY=
CHOCO_DATA_COUNTRY=br
INSTAGRAM_CHOCODATA_ENABLED=true
SCRAPER_SERVICE_URL=
SCRAPER_API_KEY=
EXPO_ACCESS_TOKEN=
ENRICH_CACHE_ENABLED=true
ENRICH_CACHE_DB_PATH=./data/enrich_cache.db

# Cloud Run / free tier: WEB_CONCURRENCY=1. Hetzner can keep 2.
# WEB_CONCURRENCY=1
# PORT=8000
