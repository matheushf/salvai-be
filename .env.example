# ── Supabase ─────────────────────────────────────────────────────────────────
# Find all values in: Supabase Dashboard → Project Settings → API

# Project URL (e.g. https://<ref>.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role secret — never expose to frontend or clients
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret — used when Supabase signs user JWTs with HS256 (legacy symmetric).
# Many projects now use ES256; the API verifies those via JWKS at
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json — fill this from the dashboard anyway.
# Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:8081,https://your-production-domain.com

# ── Instagram scraper guard (optional) ────────────────────────────────────────
# When set, the GET /api/v1/instagram/post endpoint requires
# X-Api-Key: <value> on every request.
# Leave empty or unset to keep the endpoint publicly accessible (default).
INSTAGRAM_API_KEY=

# ── Instagram scraper auth (optional) ──────────────────────────────────────────
# When both are set, the scraper loads a saved Instagram session file instead of
# hitting the GraphQL API anonymously, which raises the rate-limit ceiling.
# Create the session file with:  instaloader -l USERNAME
# Then set the path to it (e.g. .instagram_session or the default session path).
# Leave empty to use anonymous access (fine for low-volume use).
INSTAGRAM_USERNAME=
INSTAGRAM_SESSION_FILE=

# ── salvai-scraper (required for generic web enrichment) ─────────────────────
# Private web enrichment service. Generic web URLs delegate here via POST /enrich.
# Local dev (matches salvai-scraper default PORT): http://127.0.0.1:8000
# Production: https://api.locaweb.salvai.cloud
SCRAPER_SERVICE_URL=http://127.0.0.1:8000
SCRAPER_API_KEY=

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# Error monitoring. Leave SENTRY_DSN empty in local dev to disable reporting.
# Production: create a Python/FastAPI project at https://sentry.io and paste the DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Performance tracing sample rate (0.0 = errors only). Increase when you want APM.
SENTRY_TRACES_SAMPLE_RATE=0.0
# Optional release identifier (e.g. git commit SHA) for regression tracking.
SENTRY_RELEASE=

# ── Production Docker (optional) ──────────────────────────────────────────────
# Uvicorn worker count inside the container. Default is 2 when unset.
# Use 1 on a small VPS if memory is tight (less crash isolation).
# WEB_CONCURRENCY=2
